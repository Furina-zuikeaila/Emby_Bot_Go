# =========================================
# Emby Telegram Bot - 本地运行配置 (.env)
# =========================================
# -----------------------------
# Telegram 基础
# -----------------------------
# 机器人 Token（必填）
# - 从 @BotFather 获取
# - 形如：123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TG_BOT_TOKEN=

# 机器人用户名（建议填写）
# - 用于生成 /start 分享链接（例如导出邀请码链接）
# - 不要带 @
TG_BOT_USERNAME=

# Owner（可选）
# - 接收治理/告警通知
# - 也会被视为管理员（拥有 /admin 权限）
TG_OWNER_ID=

# 管理员列表（可选）
# - 允许使用 /admin、/users、/renew 等管理指令
# - 多个用英文逗号分隔
TG_ADMIN_IDS=

# -----------------------------
# Telegram 群组/频道治理
# -----------------------------
# 治理总开关
# - true：开启治理（入群/入频道校验、未授权群退群、反频道发言、退群回收等）
# - false：关闭治理（只保留私聊功能）
TG_GOV_ENABLED=true

# 授权群组列表（建议配置）
# - 仅允许 Bot 存在于这些群中（配合 TG_ANTI_USE_BOT=true）
# - 也用于“是否已入群”的校验（配合 TG_REQUIRE_GROUP=true）
# - 示例：TG_GROUP_IDS=-1001234567890,-1009876543210
TG_GROUP_IDS=

# 主群公开用户名（可选）
# - 用于生成加入链接：https://t.me/<username>
# - 不要带 @
TG_MAIN_GROUP_USERNAME=

# 主群邀请链接（可选，优先级高于 TG_MAIN_GROUP_USERNAME）
# - 私有群建议填写：https://t.me/+xxxxxxxxxxxx
TG_MAIN_GROUP_INVITE_LINK=

# 频道 ID（可选，推荐在“成员校验”时使用；与 TG_CHANNEL_USERNAME 二选一）
# - 示例：-1001122334455
TG_CHANNEL_ID=

# 频道公开用户名（可选；当 TG_CHANNEL_ID=0 时作为校验目标）
# - 用于生成加入链接：https://t.me/<username>
# - 不要带 @
TG_CHANNEL_USERNAME=

# 频道邀请链接（可选，优先级高于 TG_CHANNEL_USERNAME）
# - 私有频道建议填写：https://t.me/+xxxxxxxxxxxx
TG_CHANNEL_INVITE_LINK=

# 私聊入口是否强制要求“已入群/已关注频道”
# - true：不满足则提示加入，并提供“✅ 我已加入，重新验证”按钮
TG_REQUIRE_GROUP=true
TG_REQUIRE_CHANNEL=true

# 群内命令治理（可选）
# - true：普通用户在群里使用命令会被删消息；若该用户已注册/已绑定，则会直接删号并私信通知
# - 说明：该开关也可在管理员面板里动态切换（仅影响当前进程，重启后以此处配置为准）
TG_GUARD_GROUP_COMMANDS=false

# 治理严格模式（推荐开启）
# - false（默认）：当“无法验证成员身份/配置不完整/权限不足”时，按放行处理（偏可用性）
# - true：当“无法验证成员身份/配置不完整/权限不足”时，按不通过处理（偏安全，避免绕过）
# - 在“退群回收/违规回收”逻辑中也会作为更严格的处理策略依据
TG_GOV_STRICT=true

# 退群时是否回收账号（实时事件）
# - true：监听用户退出授权群（TG_GROUP_IDS），必要时回收账号
# - 注意：Bot 必须在群内且能收到 OnUserLeft 事件
TG_REVOKE_ON_LEAVE=true

# 退群触发回收时，是否在群内封禁该用户（仅对“触发回收”的退群事件生效）
# - 需要 Bot 为管理员并具备封禁权限
TG_BAN_ON_LEAVE=true

# 未授权群退群
# - true：Bot 被拉进不在 TG_GROUP_IDS 的群时，通知 owner 并在 30s 后自动退出
# - 需要提前配置 TG_GROUP_IDS
TG_ANTI_USE_BOT=true

# 反频道发言（群内）
# - true：检测到“以频道身份发言”的消息后，调用 banChatSenderChat 封禁该频道发言并删除消息
# - 需要 Bot 为管理员并具备封禁权限
TG_ANTI_CHANNEL=false

# 反频道白名单（可选）
# - 允许这些 sender_chat_id（频道 ID）在群里发言
TG_ANTI_CHANNEL_WHITELIST_IDS=

# -----------------------------
# 发电支持（TRC20）
# -----------------------------
# 是否启用“发电”功能
# - true：用户转账后发送交易哈希（TxID），机器人校验后发放 1 枚 0 天邀请码
# - false：关闭该功能
TG_CROWDFUND_ENABLED=true

# 收款地址（TRON Base58 地址）
TG_CROWDFUND_TRC20_ADDRESS=

# 最低发放金额（十进制）
# - 例如：10 / 10.5
# - 填 0 表示只要求金额 > 0
TG_CROWDFUND_MIN_AMOUNT=1

# TRC20 合约地址（例如 USDT TRC20）
# - 默认值为 USDT(TRC20) 合约：TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
TG_CROWDFUND_TRC20_CONTRACT=

# 展示用币种符号（例如 USDT）
TG_CROWDFUND_TRC20_SYMBOL=USDT

# 最小单位精度（USDT TRC20 通常为 6）
TG_CROWDFUND_TRC20_DECIMALS=6

# TronScan API 基址（可选）
# - 默认：https://apilist.tronscanapi.com
TG_CROWDFUND_TRONSCAN_API_BASE=https://apilist.tronscanapi.com

# TronScan 请求超时（可选，Go duration）
# - 示例：10s / 30s / 1m
TG_CROWDFUND_HTTP_TIMEOUT=10s

# TronScan 分页参数（可选）
# - SearchLimit：每页条数
# - SearchMaxPages：最多扫描页数（避免无限拉取）
TG_CROWDFUND_SEARCH_LIMIT=50
TG_CROWDFUND_SEARCH_MAX_PAGES=10

# -----------------------------
# 用户邀请（/Harem）
# -----------------------------
# 允许邀请的最低账号持有天数（从注册/绑定时间起算）
# - 默认 30（约 1 个月）
# - 0：不限制
TG_INVITE_MIN_ACCOUNT_AGE_DAYS=7

# 邀请成功后的冷却天数（邀请码被使用后）
# - 默认 90
# - 0：不限制
TG_INVITE_COOLDOWN_DAYS=30

# /Harem 定向邀请：预留资格有效期（Go duration）
# - 默认 12h
TG_INVITE_RESERVATION_TTL=12h

# /Harem 定向邀请：预留资格回收扫描间隔（Go duration）
# - 默认 10m
TG_INVITE_RESERVATION_GC_INTERVAL=10m

# -----------------------------
# Emby 配置
# -----------------------------
# Emby 地址（必填）
# - 形如：https://example.com/emby
# - 末尾不要带多余的 /
EMBY_BASE_URL=

# Emby API Key（必填）
# - Emby 后台 -> API Keys
EMBY_API_KEY=

# 同账号同时播放限制（推荐 1）
# - 1：同一账号同一时间只允许 1 路播放（禁止多设备同时播放）
# - 0：不限制（由 Emby 默认策略决定）
EMBY_SIMULTANEOUS_STREAM_LIMIT=1

# 是否跳过 TLS 证书校验（可选）
# - 自签证书时可设为 true（存在安全风险）
EMBY_INSECURE_SKIP_VERIFY=false

# 对外线路地址（可选，推荐填写域名）
# - 仅用于“服务器信息”等对外展示，不参与 Emby API 调用
# - 优先读取 EMBY_PUBLIC_URL，其次 EMBY_LINE
# - 留空则不展示（避免暴露后端地址）
EMBY_PUBLIC_URL=

# - 填图片 URL（http/https），或直接填 Telegram file_id（更稳定）
# - 留空则 /start 只发文字
TG_START_IMAGE_URL=https://cdn.nodeimage.com/i/omTSEjk5jwI99FcjYRDszaEltYx7menX.webp

# -----------------------------
# MySQL 数据库（必填）
# -----------------------------
# 推荐方案（不使用 DSN）：使用下面这些拆分参数，程序会自动拼接 DSN
# - 注意：密码/库名等如包含特殊字符，建议用引号包起来，例如 MYSQL_PASSWORD="p@ss/word"
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# DSN 额外参数（可选）
# - 默认：charset=utf8mb4&parseTime=True&loc=Local
# - loc 如需 Asia/Shanghai：loc=Asia%2FShanghai（注意需要 URL 编码 /）
MYSQL_PARAMS=charset=utf8mb4&parseTime=True&loc=Local

# 兼容方案（直接 DSN，可选，优先级更高）
# - 如果 MYSQL_DSN 不为空，将忽略上面的拆分参数
# - Example: user:pass@tcp(127.0.0.1:3306)/emby_bot?charset=utf8mb4&parseTime=True&loc=Local
MYSQL_DSN=

# -----------------------------
# 后台作业 / 定时任务（Scheduler）
# -----------------------------
# 单次任务超时时间（建议保守一点，避免 API 卡住导致堆积）

SCHED_JOB_TIMEOUT=10m

# 到期回收
# - 逻辑：expires_at < now => 删除 Emby 用户，并把账号重置为“未注册”
SCHED_EXPIRED_ENABLED=false
SCHED_EXPIRED_INTERVAL=60m

# 不活跃检测（可选）
# - 仅对“存在有效期”的用户生效：到期后才开始计算不活跃时长
# - 不活跃时长以 accounts.last_played_at（观影记录同步）为准；若无观影记录则从到期时间开始算
SCHED_INACTIVE_ENABLED=false
SCHED_INACTIVE_INTERVAL=30m

# 群/频道成员定时检查
# - 需要：TG_GOV_ENABLED=true 且 TG_REQUIRE_GROUP/TG_REQUIRE_CHANNEL 至少一个为 true
SCHED_GROUP_ENABLED=true
SCHED_GROUP_INTERVAL=1h

# Web 客户端检测（可选）
# - 用于检测“Web 播放器异常/无头客户端”等情况（具体逻辑以代码实现为准）
# - WebClientDelete=true 时，检测命中可能会触发删除/回收（高风险，建议先在测试环境验证）
SCHED_WEBCLIENT_ENABLED=true
SCHED_WEBCLIENT_INTERVAL=15m
SCHED_WEBCLIENT_DELETE=true


# 观影记录同步（可选）
# - 定时从 Emby 拉取每个用户的最近一次观看记录，并写入 accounts.last_played_at
# - 用于“不活跃时长”计算与社区模式切换清理策略
SCHED_PLAYBACK_ENABLED=true
SCHED_PLAYBACK_INTERVAL=30m

# -----------------------------
# 其他
# -----------------------------

# 不活跃时长阈值（用于“公益 -> 公费”模式切换清理策略）
# - 以“最后一次观影记录时间 last_played_at”为起点，超过阈值视为不活跃
# - 支持 Go time.ParseDuration，例如：720h、168h、30m
# - 也支持 30d（天），会按 30*24h 处理
# - 若管理员面板已设置不活跃时长（写入数据库），则以数据库为准；该值仅作为默认/回退
COMM_INACTIVE_DURATION=120h
# 服务模式（仅用于管理员面板展示）
# - private / public / charity（或填任意自定义文本）
SERVICE_MODE=charity

# =============================
# 社区模式（管理员可在面板切换）
# =============================
# - 该值仅用于“初始默认值/回退值”
# - 一旦在管理员面板里切换，模式会写入数据库并优先生效
# - 取值：private / public / charity
# 环境标识（目前仅用于区分开发/生产配置习惯）
APP_ENV=dev

# 是否运行在容器内（可选）
# - true/false；留空则程序会尽力自动判断（Linux/K8s）
# - 该值会影响部分默认值（例如默认 MySQL Host、默认 HealthAddr）
RUNNING_IN_CONTAINER=

# 健康检查端口（GET http://HEALTH_ADDR/health => ok）
HEALTH_ADDR=127.0.0.1:8801

# Emby 线路地址兼容字段（可选）
# - 若 EMBY_PUBLIC_URL 为空，则会尝试读取 EMBY_LINE 作为对外展示地址
EMBY_LINE=
